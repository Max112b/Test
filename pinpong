import pygame
import sys

pygame.init()

WIDTH = 800
HEIGHT = 600

WHITE = (255, 255, 255)
BLACK = (0, 0, 0)
LIGHT_BLUE = (173, 216, 230)
GREEN = (0, 255, 0)

screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Ping-Pong")
clock = pygame.time.Clock()

PADDLE_W = 15
PADDLE_H = 100
BALL_SIZE = 15

left_paddle_y = HEIGHT // 2 - PADDLE_H // 2
right_paddle_y = HEIGHT // 2 - PADDLE_H // 2
ball_x = WIDTH // 2
ball_y = HEIGHT // 2
ball_dx = 5
ball_dy = 5

left_score = 0
right_score = 0
game_over = False

left_speed = 0
right_speed = 0
PADDLE_SPEED = 7

while True:
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            pygame.quit()
            sys.exit()
        
        if event.type == pygame.KEYDOWN:
            if event.key == pygame.K_w:
                left_speed = -PADDLE_SPEED
            if event.key == pygame.K_s:
                left_speed = PADDLE_SPEED
            if event.key == pygame.K_UP:
                right_speed = -PADDLE_SPEED
            if event.key == pygame.K_DOWN:
                right_speed = PADDLE_SPEED
            if event.key == pygame.K_SPACE and game_over:
                game_over = False
                left_score = 0
                right_score = 0
                ball_x = WIDTH // 2
                ball_y = HEIGHT // 2
                ball_dx = 5
                ball_dy = 5
                left_paddle_y = HEIGHT // 2 - PADDLE_H // 2
                right_paddle_y = HEIGHT // 2 - PADDLE_H // 2
        
        if event.type == pygame.KEYUP:
            if event.key in (pygame.K_w, pygame.K_s):
                left_speed = 0
            if event.key in (pygame.K_UP, pygame.K_DOWN):
                right_speed = 0
    
    if not game_over:
        left_paddle_y += left_speed
        right_paddle_y += right_speed
        

        if left_paddle_y < 0:
            left_paddle_y = 0
        if left_paddle_y + PADDLE_H > HEIGHT:
            left_paddle_y = HEIGHT - PADDLE_H
        
        if right_paddle_y < 0:
            right_paddle_y = 0
        if right_paddle_y + PADDLE_H > HEIGHT:
            right_paddle_y = HEIGHT - PADDLE_H
        

        ball_x += ball_dx
        ball_y += ball_dy
        

        if ball_y <= 0 or ball_y + BALL_SIZE >= HEIGHT:
            ball_dy = -ball_dy
        
  

        if ball_x <= 50 + PADDLE_W and ball_y + BALL_SIZE >= left_paddle_y and ball_y <= left_paddle_y + PADDLE_H:
            if ball_dx < 0:
                ball_dx = -ball_dx
                if abs(ball_dx) < 15:
                    ball_dx *= 1.1
        

        if ball_x + BALL_SIZE >= WIDTH - 50 - PADDLE_W and ball_y + BALL_SIZE >= right_paddle_y and ball_y <= right_paddle_y + PADDLE_H:
            if ball_dx > 0:
                ball_dx = -ball_dx
                if abs(ball_dx) < 15:
                    ball_dx *= 1.1
        
        # Гол
        if ball_x <= 0:
            right_score += 1
            if right_score >= 5:
                game_over = True
            else:
                ball_x = WIDTH // 2
                ball_y = HEIGHT // 2
                ball_dx = 5
                ball_dy = 5
        
        if ball_x + BALL_SIZE >= WIDTH:
            left_score += 1
            if left_score >= 5:
                game_over = True
            else:
                ball_x = WIDTH // 2
                ball_y = HEIGHT // 2
                ball_dx = -5
                ball_dy = 5
    

    screen.fill(LIGHT_BLUE)
    
  
    pygame.draw.line(screen, BLACK, (WIDTH // 2, 0), (WIDTH // 2, HEIGHT), 2)
    

    pygame.draw.rect(screen, WHITE, (50, left_paddle_y, PADDLE_W, PADDLE_H))
    pygame.draw.rect(screen, BLACK, (50, left_paddle_y, PADDLE_W, PADDLE_H), 3)
    
    pygame.draw.rect(screen, WHITE, (WIDTH - 65, right_paddle_y, PADDLE_W, PADDLE_H))
    pygame.draw.rect(screen, BLACK, (WIDTH - 65, right_paddle_y, PADDLE_W, PADDLE_H), 3)
    

    pygame.draw.rect(screen, GREEN, (ball_x, ball_y, BALL_SIZE, BALL_SIZE))
    pygame.draw.rect(screen, BLACK, (ball_x, ball_y, BALL_SIZE, BALL_SIZE), 2)
    
    # Счет
    try:
        font = pygame.font.Font(None, 36)
        left_text = font.render(str(left_score), True, BLACK)
        right_text = font.render(str(right_score), True, BLACK)
        screen.blit(left_text, (WIDTH // 2 - 100, 20))
        screen.blit(right_text, (WIDTH // 2 + 70, 20))
    except:
        pass
    

    if game_over:
        screen.fill(WHITE)
        try:
            font = pygame.font.Font(None, 36)
            if left_score >= 5:
                msg = "Left wins! Press SPACE"
            else:
                msg = "Right wins! Press SPACE"
            text = font.render(msg, True, BLACK)
            screen.blit(text, (WIDTH // 2 - text.get_width() // 2, HEIGHT // 2))
        except:
            pass
    
    pygame.display.flip()
    clock.tick(60)
