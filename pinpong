import pygame
import sys
import os

try:
    os.environ['SDL_VIDEO_WINDOW_POS'] = '100,100'
except:
    pass

pygame.init()

WIDTH = 800
HEIGHT = 600

WHITE = (255, 255, 255)
BLACK = (0, 0, 0)
LIGHT_BLUE = (173, 216, 230)
BLUE = (0, 100, 255)
RED = (255, 50, 50)
GOLD = (255, 215, 0)

screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Пинг-понг")
clock = pygame.time.Clock()

PADDLE_W = 15
PADDLE_H = 100
BALL_SIZE = 18

left_paddle_y = HEIGHT // 2 - PADDLE_H // 2
right_paddle_y = HEIGHT // 2 - PADDLE_H // 2
ball_x = WIDTH // 2 - BALL_SIZE // 2
ball_y = HEIGHT // 2 - BALL_SIZE // 2
ball_dx = 5
ball_dy = 5

PADDLE_SPEED = 7
left_speed = 0
right_speed = 0

game_over = False
winner = ""

running = True

while running:
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False
        
        if event.type == pygame.KEYDOWN:
            if event.key == pygame.K_ESCAPE:
                running = False
            
            if event.key == pygame.K_w:
                left_speed = -PADDLE_SPEED
            if event.key == pygame.K_s:
                left_speed = PADDLE_SPEED
            if event.key == pygame.K_UP:
                right_speed = -PADDLE_SPEED
            if event.key == pygame.K_DOWN:
                right_speed = PADDLE_SPEED
            if event.key == pygame.K_SPACE and game_over:
                game_over = False
                winner = ""
                ball_x = WIDTH // 2 - BALL_SIZE // 2
                ball_y = HEIGHT // 2 - BALL_SIZE // 2
                ball_dx = 5
                ball_dy = 5
                left_paddle_y = HEIGHT // 2 - PADDLE_H // 2
                right_paddle_y = HEIGHT // 2 - PADDLE_H // 2
        
        if event.type == pygame.KEYUP:
            if event.key in (pygame.K_w, pygame.K_s):
                left_speed = 0
            if event.key in (pygame.K_UP, pygame.K_DOWN):
                right_speed = 0
    
    if not game_over:
        left_paddle_y += left_speed
        right_paddle_y += right_speed
        
        if left_paddle_y < 0: left_paddle_y = 0
        if left_paddle_y + PADDLE_H > HEIGHT: left_paddle_y = HEIGHT - PADDLE_H
        
        if right_paddle_y < 0: right_paddle_y = 0
        if right_paddle_y + PADDLE_H > HEIGHT: right_paddle_y = HEIGHT - PADDLE_H
        
        ball_x += ball_dx
        ball_y += ball_dy
        
        if ball_y <= 0 or ball_y + BALL_SIZE >= HEIGHT:
            ball_dy = -ball_dy
        
        if ball_x <= 50 + PADDLE_W and ball_y + BALL_SIZE >= left_paddle_y and ball_y <= left_paddle_y + PADDLE_H:
            if ball_dx < 0: ball_dx = -ball_dx
        
        if ball_x + BALL_SIZE >= WIDTH - 65 - PADDLE_W and ball_y + BALL_SIZE >= right_paddle_y and ball_y <= right_paddle_y + PADDLE_H:
            if ball_dx > 0: ball_dx = -ball_dx
        
        if ball_x <= 0:
            game_over = True
            winner = "КРАСНЫЙ ПОБЕДИЛ!"
        
        if ball_x + BALL_SIZE >= WIDTH:
            game_over = True
            winner = "СИНИЙ ПОБЕДИЛ!"

    if not game_over:
        screen.fill(LIGHT_BLUE)
        pygame.draw.line(screen, BLACK, (WIDTH // 2, 0), (WIDTH // 2, HEIGHT), 2)
        pygame.draw.rect(screen, BLUE, (50, left_paddle_y, PADDLE_W, PADDLE_H))
        pygame.draw.rect(screen, BLACK, (50, left_paddle_y, PADDLE_W, PADDLE_H), 3)
        pygame.draw.rect(screen, RED, (WIDTH - 65, right_paddle_y, PADDLE_W, PADDLE_H))
        pygame.draw.rect(screen, BLACK, (WIDTH - 65, right_paddle_y, PADDLE_W, PADDLE_H), 3)
        
        center_x = int(ball_x + BALL_SIZE // 2)
        center_y = int(ball_y + BALL_SIZE // 2)
        pygame.draw.circle(screen, WHITE, (center_x, center_y), BALL_SIZE // 2)
        pygame.draw.circle(screen, BLACK, (center_x, center_y), BALL_SIZE // 2, 2)
    else:
        screen.fill(BLACK)
        pygame.draw.rect(screen, GOLD, (50, 100, WIDTH - 100, HEIGHT - 200), 5)
        try:
            title_font = pygame.font.Font(None, 72)
            title = title_font.render("ИГРА ОКОНЧЕНА", True, GOLD)
            screen.blit(title, (WIDTH // 2 - title.get_width() // 2, 150))
            
            winner_font = pygame.font.Font(None, 64)
            winner_text = winner_font.render(winner, True, WHITE)
            screen.blit(winner_text, (WIDTH // 2 - winner_text.get_width() // 2, 280))
            
            info_font = pygame.font.Font(None, 36)
            info_text = info_font.render("SPACE - новая игра, ESC - выход", True, GOLD)
            screen.blit(info_text, (WIDTH // 2 - info_text.get_width() // 2, 400))
            
            hint_font = pygame.font.Font(None, 28)
            hint1 = hint_font.render("Синий игрок: W/S", True, BLUE)
            hint2 = hint_font.render("Красный игрок: UP/DOWN", True, RED)
            screen.blit(hint1, (WIDTH // 2 - hint1.get_width() // 2, 470))
            screen.blit(hint2, (WIDTH // 2 - hint2.get_width() // 2, 500))
        except:
            pass
    
    pygame.display.flip()
    clock.tick(60)

pygame.quit()
sys.exit()
